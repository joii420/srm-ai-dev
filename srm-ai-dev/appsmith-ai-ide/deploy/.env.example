# ============================================================
# Appsmith AI IDE - Production Environment Variables
# Copy this file to .env and modify as needed
# ============================================================

# ---- Database ----
DB_USER=aiide
DB_PASSWORD=aiide_prod_strong_password_here
DB_NAME=aiide
DB_PORT_EXPOSE=5432

# ---- Application Ports ----
APP_PORT=80
BACKEND_PORT=3100

# ---- JWT ----
JWT_SECRET=your-production-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=28800

# ---- Container Management ----
CONTAINER_IMAGE_NAME=appsmith-ai-ide-container:latest
CONTAINER_MEMORY_LIMIT=1g
CONTAINER_CPU_LIMIT=1.0
CONTAINER_MAX_CONCURRENT=20

# ---- SSH / Git ----
SSH_KEY_ENCRYPT_SECRET=your-production-ssh-encrypt-secret
GIT_TOKEN=
GIT_REPO_PREFIX=git@github.com:your-org/
SSH_KEY_DIR=./sshkey

# ---- AI Agent ----
AI_AGENT_URL=
BACKEND_URL_FOR_CONTAINER=http://host.docker.internal:3100

# ---- Appsmith Session (optional) ----
APPSMITH_SESSION=
APPSMITH_XSRF_TOKEN=

# ---- Third-party Page API (optional) ----
PAGES_THIRD_PARTY_API_URL=
PAGES_THIRD_PARTY_API_TOKEN=
