FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    openssh-client \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pm2 pnpm

WORKDIR /build

# Copy tsconfig.base.json (needed by container-services/tsconfig.json extends)
COPY tsconfig.base.json /build/tsconfig.base.json

# Copy container-services source
COPY packages/container-services/ /build/packages/container-services/

# Install dependencies and build
WORKDIR /build/packages/container-services
RUN pnpm install --frozen-lockfile || pnpm install
RUN pnpm build

# Move the built output to /app
RUN mkdir -p /app /workspace /deps /skills
RUN cp -r dist/ /app/dist/
RUN cp package.json /app/package.json
RUN cp -r node_modules/ /app/node_modules/

WORKDIR /app

COPY docker/pm2.config.cjs /app/pm2.config.cjs

# Clean up build artifacts
RUN rm -rf /build

EXPOSE 3000 3001

CMD ["pm2-runtime", "pm2.config.cjs"]
