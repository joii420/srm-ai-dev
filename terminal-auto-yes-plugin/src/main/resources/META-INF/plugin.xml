<idea-plugin>
    <id>com.joii.terminal-auto-yes</id>
    <name>Terminal Auto Yes</name>
    <version>1.0.0</version>
    <vendor>Joii</vendor>
    <description><![CDATA[
        自动检测终端中的确认提示（Do you want to proceed?），并自动选择 Yes。
        支持经典终端和新版终端引擎。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.joii.terminalautyes.TerminalAutoYesService"/>
        <statusBarWidgetFactory implementation="com.joii.terminalautyes.AutoYesStatusBarWidgetFactory"
                                id="TerminalAutoYesWidget"
                                order="after position"/>
    </extensions>

    <actions>
        <group id="TerminalAutoYes.Group" text="Terminal Auto Yes" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="TerminalAutoYes.Toggle"
                    class="com.joii.terminalautyes.ToggleAutoYesAction"
                    text="Enable Auto Yes"
                    description="Toggle automatic Yes selection in terminal prompts"/>
            <action id="TerminalAutoYes.SwitchMode"
                    class="com.joii.terminalautyes.SwitchMonitorModeAction"
                    text="Switch Monitor Mode"
                    description="Switch between active terminal and all terminals monitoring"/>
        </group>
    </actions>
</idea-plugin>
